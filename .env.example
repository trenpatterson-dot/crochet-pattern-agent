# LLM provider
LLM_PROVIDER=anthropic
ANTHROPIC_TIMEOUT_SECONDS=90

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:latest

# Token and speed controls
ORIGINAL_PATTERN_COUNT=1
ORIGINAL_PATTERN_DETAIL=compact
EMAIL_DRY_RUN=true

# Gmail SMTP
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Flask
FLASK_SECRET_KEY=change_this_to_a_random_string
UNSUBSCRIBE_SECRET=change_this_to_a_different_random_string
FLASK_PORT=5050
ADMIN_PASSWORD=change_this_for_admin_access
